            "hidden": false,
            "permanent": false
        },
        "7": {
            "description": "Check the stairs",
            "message": "Narrow staircase leads into a dark room. Turning on flashlight reveals a huge sarcophagus near a wall and a small section guarded by a white spooky figure.",
            "hidden": true,
            "permanent": false
        },
        "8": {
            "description": "Check the arc",
            "message": "A huge metal container stands behind the arc. I wonder, what could be in it.",
            "hidden": true,
            "permanent": false
        },
        "9": {
            "description": "Check the door",
            "message": "You've tried to open it, but it just fell to the ground and shuttered into small pieces. The opened passage revealed a dimly lit room.",
            "hidden": true,
            "permanent": false
        },
        "10": {
            "description": "Explore the room",
            "message": "The light comes from a small window (more like a hole).\nYou've noticed an ape in the corner. It's a baboon. The animal is persistently hitting a closed plastic bottle of Cola with a bone. More bones lie around.",
            "hidden": true,
            "permanent": false
        },
        "11": {
            "description": "Approach the baboon",
            "message": "You're trying to get closer to the ape, but it roars at you aggressively. Then it proceeds with the attempts of smashing the bottle.",
            "hidden": true,
            "permanent": true
        },
        "12": {
            "description": "Open the container",
            "message": "It's pointless. The container is locked and the lock is covered with rust.",
            "hidden": true,
            "permanent": true
        },
        "13": {
            "description": "Examine the sarcophagus",
            "message": "It's made of stone. The lid is opened. It's empty.",
            "hidden": true,
            "permanent": true
        },
        "14": {
            "description": "Enter the section",
            "message": "The white figure suddenly howls making you shiver. You notice it's transparent. Oh no! Is it a real ghost? You can't go further.",
            "hidden": true,
            "permanent": false
        },
        "15": {
            "description": "Turn on the player",
            "message": "You play an obnoxious composition from a popular artist.",
            "hidden": true,
            "permanent": false
        },
        "16": {
            "description": "Approach the baboon",
            "message": "The ape can't withstand the sound Nicki Minaj. It squishes through the window leaving the bottle behind.",
            "hidden": true,
            "permanent": false
        },
        "17": {
            "description": "Collect the bones",
            "message": "You've collected the bones and placed them in your backpack.",
            "hidden": true,
            "permanent": false
        },
        "18": {
            "description": "Take Cola",
            "message": "You've picked the bottle and placed it in your backpack.",
            "hidden": true,
            "permanent": false
        },
        "19": {
            "description": "Put bones into the sarcophagus",
            "message": "You've placed the bones where they belong. The ghost disappears.",
            "hidden": true,
            "permanent": false
        },
        "20": {
