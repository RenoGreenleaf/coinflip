{
	"exit": {
		"type": "exit",
		"message": "Bye-bye!"
	},
	"coin_flip": {
		"type": "coin_flip",
		"i_won": "coinflip.i_won",
		"opponent_won": "coinflip.opponent_won"
	},
	"lockpick": {
		"type": "lockpick"
	},
	"room": {
		"type": "room"
	},
	"menu": {
		"type": "conversation",
		"options": [
			{
				"description": "Coin flip",
				"triggers": "menu.coinflip_selected",
				"message": "Playing coin flip."
			},
			{
				"description": "Lock-pick",
				"triggers": "menu.lockpick_selected"
			},
			{
				"description": "Explore",
				"triggers": "menu.exploration_selected"
			},
			{
				"description": "Help",
				"triggers": "menu.help_selected"
			},
			{
				"description": "Back",
				"triggers": "state_machine.previous_requested",
				"show_condition": "state_machine.previous_scene_available",
				"available": false
			}
		]
	},
	"help": {
		"type": "conversation",
		"options": [
			{
				"description": "Where am I?",
				"message": "You're in a playroom.",
				"triggers": "help.asked_where"
			},
			{
				"description": "What can I play here?",
				"message": "Try coinflip. There's also lock picking game. Lastly, you can turn a table.",
				"show_condition": "help.asked_where",
				"triggers": "help.asked_what_to_play",
				"available": false
			},
			{
				"description": "How to play coinflip?",
				"message": "When prompted, specify your preferred side (heads or tails).\nYour current score is available in format <your points>/<opponents points>.\nIt's shown after each flip.",
				"show_condition": "help.asked_what_to_play",
				"available": false
			},
			{
				"description": "How to pick locks?",
				"message": "Turn your lockpick left & right.\nCorrect combination of turns opens a lock.\nIf a turn is incorrect you have to start over.",
				"show_condition": "help.asked_what_to_play",
				"available": false
			},
			{
				"description": "How to leave?",
				"message": "You can leave by typing in \"exit\"."
			},
			{
				"description": "Back",
				"triggers": "state_machine.previous_requested",
				"show_condition": "state_machine.previous_scene_available",
				"available": false
			}
		]
	}
}